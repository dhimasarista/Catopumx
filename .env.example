# Connection string for the Vault (Postgres / MySQL / SQLite).
# Leave unset or empty to run Catopumx in No-DB Mode (broadcast-only, no persistence).
#
# Examples:
#   DATABASE_URL=postgres://user:password@localhost:5432/catopumx
#   DATABASE_URL=mysql://user:password@localhost:3306/catopumx
#   DATABASE_URL=sqlite://catopumx.db
DATABASE_URL=

# Log verbosity is controlled via the standard ASP.NET Core logging config
# (appsettings.json / Logging__LogLevel__Default env var), not this file.

# Address the embedded MQTT broker listens on for device connections.
MQTT_LISTEN_ADDR=0.0.0.0:1883

# Credentials required from MQTT clients. Leaving either unset means the
# broker accepts UNAUTHENTICATED connections from anyone who can reach
# MQTT_LISTEN_ADDR (fine for local development; set both before exposing it
# beyond localhost/a trusted network).
MQTT_USERNAME=
MQTT_PASSWORD=

# Address the HTTP broadcaster (health check, SSE, state API) listens on.
HTTP_LISTEN_ADDR=0.0.0.0:3000
